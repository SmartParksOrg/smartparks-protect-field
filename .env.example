# Smart Parks Protect Go. Copy to .env to change a default; nothing here is required.
# Every variable is read by protect_go/config.py with the prefix PROTECT_GO_.

# Where the bundles, the cards and the local database live. Created on start.
PROTECT_GO_DATA_DIR=data
# The address the local server listens on. Keep 127.0.0.1 unless another device on the same
# network must reach the interface.
PROTECT_GO_HOST=127.0.0.1
PROTECT_GO_PORT=18090
