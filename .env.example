# Smart Parks Protect Field. Copy to .env to change a default; nothing here is required.
# Every variable is read by protect_field/config.py with the prefix FIELD_.

# Where the bundles, the cards and the local database live. Created on start.
FIELD_DATA_DIR=data
# The address the local server listens on. Keep 127.0.0.1 unless another device on the same
# network must reach the interface.
FIELD_HOST=127.0.0.1
FIELD_PORT=18090
